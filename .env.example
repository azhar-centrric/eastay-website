# Copy to .env.local and fill in.

# Public site URL (used for SEO / Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number in international format, digits only (no +, spaces or dashes).
# Example: 919876543210
NEXT_PUBLIC_WHATSAPP_NUMBER=918138841989

# Enquiry form backend. LEAVE EMPTY until a backend is chosen.
# While empty, the form validates but will NOT send anything and shows a clear
# "not configured" message instead of a fake success.
# If set, the form POSTs the enquiry as JSON to this URL.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
